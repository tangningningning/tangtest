+        cwd=PROJECT_ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=10,
+    )
+    if sha_result.returncode != 0 or dirty_result.returncode != 0:
+        raise RuntimeError(
+            "unable to capture source git identity: "

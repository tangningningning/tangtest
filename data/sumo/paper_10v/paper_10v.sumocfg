<?xml version='1.0' encoding='UTF-8'?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../map/osm.net.xml.gz" />
        <route-files value="../map/osm.passenger.trips.xml,paper_vehicles.rou.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="600" />
        <step-length value="1" />
    </time>
    <processing>
        <ignore-route-errors value="false" />
        <time-to-teleport value="-1" />
    </processing>
    <random_number>
        <seed value="42" />
    </random_number>
    <report>
        <no-step-log value="true" />
        <duration-log.statistics value="true" />
    </report>
    <gui_only>
        <gui-settings-file value="../map/osm.view.xml" />
    </gui_only>
</sumoConfiguration>

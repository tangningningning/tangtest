<?xml version="1.0" encoding="UTF-8"?>

<configuration
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="map/osm.net.xml.gz"/>
        <route-files value="map/osm.passenger.trips.xml"/>
        <gui-settings-file value="map/osm.view.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <step-length value="0.1"/>
    </time>

    <output>
        <fcd-output value="output/vehicle_fcd.xml.gz"/>
        <fcd-output.acceleration value="true"/>
    </output>

    <report>
        <no-step-log value="true"/>
    </report>

</configuration>